Table roles {
  id int [pk, increment]
  name varchar(20) [unique, not null]
}

Table accounts {
  id int [pk, increment]
  role_id int [not null, ref: > roles.id]
  email varchar(150) [unique, not null]
  password_hash varchar(255) [not null]
  created_at datetime [default: `now()`]
  deleted_at datetime [null]
}

Table profiles {
  id int [pk, increment]
  account_id int [unique, not null, ref: - accounts.id]
  name varchar(100) [not null]
  phone varchar(30)
  city varchar(100)
  bio text
  profile_image_url varchar(255)
  created_at datetime [default: `now()`]
  deleted_at datetime [null]
}

Table companies {
  id int [pk, increment]
  account_id int [unique, not null, ref: - accounts.id]
  company_name varchar(150) [not null]
  tax_number varchar(30) [unique, not null]
  registration_number varchar(50)
  billing_address varchar(255) [not null]
  website varchar(255)
  phone varchar(30)
  created_at datetime [default: `now()`]
  deleted_at datetime [null]
}

Table categories {
  id int [pk, increment]
  name varchar(50) [unique, not null]
}

Table photos {
  id int [pk, increment]
  account_id int [not null, ref: > accounts.id]
  title varchar(150) [not null]
  description text
  image_url varchar(255) [not null]
  thumbnail_url varchar(255) [not null]
  view_count int [default: 0]
  show_metadata boolean [not null, default: true]
  created_at datetime [default: `now()`]
  deleted_at datetime [null]
}

Table photo_metadata {
  id int [pk, increment]
  photo_id int [unique, not null, ref: - photos.id]
  camera_make varchar(80)
  camera_model varchar(100)
  lens_model varchar(150)
  focal_length int
  aperture varchar(20)
  shutter_speed varchar(20)
  iso int
}

Table photo_categories {
  photo_id int [ref: > photos.id]
  category_id int [ref: > categories.id]

  Indexes {
    (photo_id, category_id) [pk]
  }
}

Table inquiries {
  id int [pk, increment]
  client_id int [not null, ref: > accounts.id]
  photographer_id int [not null, ref: > accounts.id]
  event_type varchar(100) [not null]
  event_date date [not null]
  location varchar(150) [not null]
  message text [not null]
  status varchar(20) [not null, default: 'pending']
  created_at datetime [default: `now()`]
  archived_at datetime [null]
  deleted_at datetime [null]
}

Table reviews {
  id int [pk, increment]
  inquiry_id int [unique, not null, ref: - inquiries.id]
  rating tinyint [not null]
  comment text
  created_at datetime [default: `now()`]
  deleted_at datetime [null]
}
